# Server-side contact delivery (future)
# Do not put secrets in NEXT_PUBLIC_* variables.

# Enable the contact form UI for live submission once a backend route exists.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false

# Example future SMTP settings (used only by a server route, never NEXT_PUBLIC)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO=contact@muhammadmiran.com
# CONTACT_FROM=noreply@muhammadmiran.com

# Public site URL used for canonical/SEO generation in some environments
# NEXT_PUBLIC_SITE_URL=https://muhammadmiran.com

# AtlasCore screenshot capture (local only — never commit real values)
# ATLASCORE_SCREENSHOT_EMAIL=
# ATLASCORE_SCREENSHOT_PASSWORD=
# ATLASCORE_BASE_URL=http://localhost:3100
